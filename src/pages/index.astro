            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span class="marquee-label">Lemlist</span>
        </div>
        
        <div class="marquee-item">
          <svg class="marquee-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span class="marquee-label">LinkedIn Sales Navigator</span>
        </div>
        
        <div class="marquee-item">
          <svg class="marquee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10v4"/>
            <path d="M6 6v12"/>
            <path d="M9 3v18"/>
            <path d="M12 5v14"/>
            <path d="M15 3v18"/>
            <path d="M18 6v12"/>
            <path d="M21 10v4"/>
          </svg>
          <span class="marquee-label">Wispr Flow</span>
        </div>
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="container grid-3 animate-fade-in-up delay-4">
      {proofPoints.map((point) => (
        <div class="card">
          <h3>{point.title}</h3>
          <p>{point.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">Case studies</span>
      <h2>Sales problems, solved like an engineer</h2>
      <div class="grid-3 studies">
        {caseStudies.map((study) => (
          <a href={study.href} class="card study-card">
            <span class="chip">{study.tag}</span>
            <h3>{study.title}</h3>
            <p>{study.body}</p>
            <span class="read-more">Read the case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="positioning">
    <div class="container narrow">
      <span class="eyebrow">Why this combination matters</span>
      <h2>A sales rep who builds sales tech</h2>
      <p class="lede">
        Most SDRs run the playbook. I rebuild it. From cold-calling scripts refined over
        thousands of dials to a live data dashboard adopted across a UK SaaS company,
        the pattern is the same: take a messy, manual process and turn it into a
        repeatable system that the whole team benefits from.
      </p>
      <p>
        <a href="/about/">More about my path from Bangladesh to Portsmouth →</a>
      </p>
    </div>
  </section>

  <section class="enterprise-band">
    <div class="container">
      <div class="card band-card">
        <div>
          <h2>Enterprise &amp; B2B campaigns</h2>
          <p class="lede">
            Beyond SMB outreach: I've run the calls that close six and seven figures,
            across insurance, home improvement, SaaS, and IT procurement.
          </p>
        </div>
        <a href="/enterprise/" class="btn btn-primary">Start a conversation</a>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding: 110px 0 80px;
      background:
        radial-gradient(ellipse 55% 45% at 75% 12%, var(--glow-1), transparent),
        radial-gradient(ellipse 45% 40% at 15% 88%, var(--glow-2), transparent),
        var(--bg);
    }

    .highlight { color: var(--accent); }

    .hero-actions {
      display: flex;
      gap: 14px;
      margin-top: 28px;
      flex-wrap: wrap;
    }

    .proof { padding-top: 56px; }

    .proof .card {
      border-top: 3px solid var(--accent);
    }

    .proof .card:nth-child(2) { border-top-color: var(--warm); }
    .proof .card:nth-child(3) { border-top-color: var(--accent-2); }

    .studies { margin-top: 28px; }

    .study-card {
      display: flex;
      flex-direction: column;
      color: var(--text);
    }

    .study-card:hover {
      text-decoration: none;
    }

    .study-card .chip {
      align-self: flex-start;
      margin-bottom: 14px;
    }

    .study-card p { color: var(--text-dim); }

    .read-more {
      margin-top: auto;
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--accent);
      transition: transform 0.2s ease;
    }

    .study-card:hover .read-more {
      transform: translateX(4px);
    }

    .positioning {
      background: linear-gradient(135deg, var(--warm-dim), var(--accent-dim));
    }

    .band-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      flex-wrap: wrap;
      background: linear-gradient(135deg, var(--bg-card), rgba(52, 211, 153, 0.06));
    }

    .band-card h2 { margin-bottom: 8px; }
    .band-card .lede { margin: 0; }

    /* Tools Marquee styling */
    .tools-section {
      padding: 56px 0 40px;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
      overflow: hidden;
    }

    .tools-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .tools-header h2 {
      margin-bottom: 12px;
    }

    .tools-header .lede {
      margin: 0 auto;
    }

    .marquee-container {
      display: flex;
      overflow: hidden;
      user-select: none;
      width: 100%;
      position: relative;
      mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    }

    .marquee-track {
      display: flex;
      flex-shrink: 0;
      gap: 32px;
      padding: 12px 16px;
      animation: scroll 32s linear infinite;
    }

    .marquee-container:hover .marquee-track {
      animation-play-state: paused;
    }

    .marquee-item {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 10px 20px;
      border-radius: 999px;
      box-shadow: 0 1px 3px rgba(20, 27, 40, 0.03);
      cursor: default;
    }

    .marquee-item:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      box-shadow: 0 8px 24px rgba(20, 27, 40, 0.08);
    }

    html.dark .marquee-item:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .marquee-icon {
      width: 20px;
      height: 20px;
      color: var(--text-dim);
      display: block;
      transition: color 0.3s ease, transform 0.3s ease;
    }

    .marquee-item:hover .marquee-icon {
      color: var(--accent);
      transform: scale(1.05);
    }

    .marquee-label {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
      white-space: nowrap;
    }

    @keyframes scroll {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-100%);
      }
    }
  </style>
</Base>
