---
import Base from '../layouts/Base.astro';

const proofPoints = [
  {
    title: 'Company-wide dashboard',
    body: 'Built a live CQC data dashboard, now used company-wide at Nourish Care for AI-driven prospecting.',
    color: 'var(--accent)',
    bgDim: 'var(--accent-dim)'
  },
  {
    title: 'AI Champion',
    body: 'Named "AI Champion" by the CMO for bringing AI-assisted research into the sales workflow.',
    color: 'var(--accent-2)',
    bgDim: 'var(--accent-2-dim)'
  },
  {
    title: 'Recognized performer',
    body: 'SDR of the Quarter and Nourish Culture Award winner.',
    color: 'var(--warm)',
    bgDim: 'var(--warm-dim)'
  },
];

const caseStudies = [
  {
    href: '/case-studies/cqc-dashboard/',
    tag: 'Shipped · In use company-wide',
    title: 'CQC Research Dashboard',
    body: 'A React/TypeScript app on live CQC data that cut provider research from minutes to seconds and put real inspection facts in the first line of every email.',
  },
  {
    href: '/case-studies/lead-enrichment/',
    tag: 'In progress',
    title: 'Lead Enrichment Pipeline',
    body: 'A Python pipeline that joins the CQC and Companies House APIs to surface decision-makers for ~180 target accounts no list vendor covers.',
  },
  {
    href: '/case-studies/competitive-intel/',
    tag: 'Living document',
    title: 'Competitive Intelligence Matrix',
    body: 'An accuracy-verified comparison of Nourish against 9+ care-sector competitors, so every competitive conversation starts from facts, not folklore.',
  },
];
---

<Base
  title="Ishraq Alam | SDR who builds sales tech"
  description="Ishraq Alam: SDR at Nourish Care, builder of AI-powered prospecting tools, recognized for turning research into revenue. Portsmouth, UK."
>
  <section class="hero">
    <!-- Ambient glowing backdrops for depth -->
    <div class="ambient-glow glow-hero-1"></div>
    <div class="ambient-glow glow-hero-2"></div>
    
    <div class="container hero-grid">
      <div class="hero-info">
        <span class="eyebrow animate-fade-in-up">Ishraq Alam · Portsmouth, UK</span>
        <h1 class="animate-fade-in-up delay-1">
          I don't just hit quota.<br />
          I build the systems that make quota <span class="text-gradient emerald">easier to hit</span>.
        </h1>
        <p class="lede animate-fade-in-up delay-2">
          SDR at Nourish Care. Builder of AI-powered prospecting tools. Recognized for
          turning research into revenue.
        </p>
        <div class="hero-actions animate-fade-in-up delay-3">
          <a href="/case-studies/" class="btn btn-primary">See the work</a>
          <a href="/enterprise/" class="btn btn-ghost">Work with me</a>
        </div>
      </div>
      
      <div class="hero-visual animate-fade-in-up delay-2">
        <div class="layered-container">
          <!-- Card 1: CQC live feed (Bottom-most, shifted left) -->
          <div class="mockup-card card-cqc">
            <div class="mockup-card-header">
              <span class="mockup-circle red"></span>
              <span class="mockup-circle yellow"></span>
              <span class="mockup-circle green"></span>
              <span class="mockup-card-title">cqc_feed_proxy.py</span>
            </div>
            <div class="mockup-card-body">
              <div class="mockup-tag">LIVE FEED</div>
              <div class="mockup-title">Willow Grange Care Home</div>
              <div class="mockup-info">Rating: <span class="status-badge alert">Requires Improvement</span></div>
              <div class="mockup-details">Safe: RI · Well-led: RI · Active since 2019</div>
            </div>
          </div>

          <!-- Card 2: Companies House data connector (Middle layer, shifted right/tilted) -->
          <div class="mockup-card card-enrich">
            <div class="mockup-card-header">
              <span class="mockup-circle red"></span>
              <span class="mockup-circle yellow"></span>
              <span class="mockup-circle green"></span>
              <span class="mockup-card-title">enrichment_match.sql</span>
            </div>
            <div class="mockup-card-body">
              <div class="connection-flow">
                <div class="flow-node">
                  <span class="node-label">CQC DB</span>
                </div>
                <div class="flow-line">
                  <svg viewBox="0 0 40 10" width="40" height="10">
                    <line x1="0" y1="5" x2="40" y2="5" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3 3"/>
                  </svg>
                </div>
                <div class="flow-node highlight">
                  <span class="node-label">Enriched</span>
                </div>
                <div class="flow-line">
                  <svg viewBox="0 0 40 10" width="40" height="10">
                    <line x1="0" y1="5" x2="40" y2="5" stroke="var(--accent-2)" stroke-width="1.5" stroke-dasharray="3 3"/>
                  </svg>
                </div>
                <div class="flow-node">
                  <span class="node-label">Directors</span>
                </div>
              </div>
              <div class="matched-stat">✓ 180 companies matched (98.4% join rate)</div>
            </div>
          </div>

          <!-- Card 3: Outreach text auto-draft (Top-most, centered and tilted forward) -->
          <div class="mockup-card card-ai">
            <div class="mockup-card-header">
              <span class="mockup-circle red"></span>
              <span class="mockup-circle yellow"></span>
              <span class="mockup-circle green"></span>
              <span class="mockup-card-title">ai_outreach_engine</span>
            </div>
            <div class="mockup-card-body">
              <div class="ai-header">
                <svg class="ai-sparkle-icon" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
                </svg>
                <span class="ai-title">AI generated outreach</span>
              </div>
              <div class="ai-quote">
                "Noticed your March inspection flagged care-plan record keeping. Teams using digital planning typically close that gap..."
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tools-section animate-fade-in-up delay-4">
    <div class="container">
      <div class="tools-header">
        <h2>Tools I am proficient in</h2>
        <p class="lede">
          Experienced across leading CRM, prospecting, outreach, and sales engagement platforms.
