---
import Base from '../layouts/Base.astro';

const stats = [
  { value: '30,000+', label: 'Cold Dials Made', color: 'var(--warm)' },
  { value: 'C2-Level', label: 'English Fluency', color: 'var(--accent-2)' },
  { value: '6+', label: 'B2B Verticals Sold', color: 'var(--accent)' },
  { value: '1', label: 'Unified Philosophy', label2: 'A closing rep who codes', color: 'var(--accent)' }
];

const timeline = [
  {
    phase: 'Phase 1: The Human Element',
    title: 'HRM Foundation',
    subtitle: 'Bangladesh · Understanding Motivation',
    body: 'I began my career in Human Resource Management. This academic and practical grounding in organizational psychology taught me to identify pain points, active-listen, and understand what makes people say yes long before I ever made a cold call.',
    color: 'var(--warm)',
    bgDim: 'var(--warm-dim)',
    iconPath: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75'
  },
  {
    phase: 'Phase 2: High-Volume Outreach',
    title: 'BPO & Remote B2B Campaigns',
    subtitle: 'Global Outreach · Millions in Pipeline',
    body: 'Transitioned to high-volume BPO centers and remote B2B telemarketing for US and Canadian markets. Refined my cold-calling technique across insurance, home improvement, SaaS, and IT procurement, learning to maintain high engagement through thousands of dials.',
    color: 'var(--accent-2)',
    bgDim: 'var(--accent-2-dim)',
    iconPath: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z M8 10h.01 M12 10h.01 M16 10h.01'
  },
  {
    phase: 'Phase 3: The System Builder',
    title: 'UK Care-Tech SDR & Developer',
    subtitle: 'Nourish Care, Portsmouth · Automation First',
    body: 'Relocated to the UK to join Nourish Care. Here, I merged sales execution with software development—building tools like the CQC Dashboard and competitive intelligence scrapers to turn slow research into instant, automated outreach loops.',
    color: 'var(--accent)',
    bgDim: 'var(--accent-dim)',
    iconPath: 'M16 18l6-6-6-6 M8 6l-6 6 6 6 M14 4l-4 16'
  }
];
---

<Base
  title="About | Ishraq Alam"
  description="From Bangladesh to Portsmouth: HR, BPO call centres, remote B2B telemarketing, and now SDR + tools developer at a UK care-tech SaaS company."
>
  <section class="about-hero">
    <div class="container grid-2 align-center">
      <div class="hero-text">
        <span class="eyebrow animate-fade-in-up">The Trajectory</span>
        <h1 class="animate-fade-in-up delay-1">
          From <span class="text-gradient warm">Bangladesh</span> to <span class="text-gradient accent">Portsmouth</span>
        </h1>
        <p class="lede animate-fade-in-up delay-2">
          I'm Ishraq Alam. I bridge the gap between human conversations and scalable sales systems, working as an SDR at Nourish Care, UK.
        </p>
        <p class="animate-fade-in-up delay-3 text-body">
          My journey spans across global BPO campaigns, remote telemarketing for North American markets, and human resource psychology. Along the way, I discovered a core pattern: <strong class="highlight-text">messy, manual processes are opportunities to build code</strong>.
        </p>
      </div>
      
      <div class="hero-visual animate-fade-in-up delay-2">
        <div class="journey-map-card">
          <div class="card-header">
            <div class="dot red"></div><div class="dot yellow"></div><div class="dot green"></div>
            <span class="card-title">journey_route.gpx</span>
          </div>
          <div class="journey-map">
            <svg viewBox="0 0 400 240" fill="none" class="journey-svg">
              <path d="M10 40h380M10 80h380M10 120h380M10 160h380M10 200h380" stroke="var(--border)" stroke-width="0.5" stroke-dasharray="4 4" />
              <path d="M40 10v220M80 10v220M120 10v220M160 10v220M200 10v220M240 10v220M280 10v220M320 10v220M360 10v220" stroke="var(--border)" stroke-width="0.5" stroke-dasharray="4 4" />
              
              <!-- Flight curve connecting Dhaka (310, 160) to Portsmouth (90, 80) -->
              <path d="M310 160 C 220 50, 180 50, 90 80" stroke="url(#gradient-path)" stroke-width="3" stroke-linecap="round" stroke-dasharray="600" stroke-dashoffset="0" class="flight-path" />
              
              <!-- Pulse circles -->
              <circle cx="310" cy="160" r="12" fill="var(--warm-dim)" class="pulse-node" />
              <circle cx="310" cy="160" r="5" fill="var(--warm)" />
              
              <circle cx="90" cy="80" r="12" fill="var(--accent-dim)" class="pulse-node delay-pulse" />
              <circle cx="90" cy="80" r="5" fill="var(--accent)" />
              
              <!-- Map Labels -->
              <text x="310" y="188" fill="var(--text)" font-family="var(--font-display)" font-size="11" font-weight="600" text-anchor="middle">Dhaka, BD</text>
              <text x="90" y="60" fill="var(--text)" font-family="var(--font-display)" font-size="11" font-weight="600" text-anchor="middle">Portsmouth, UK</text>
              
              <defs>
                <linearGradient id="gradient-path" x1="1" y1="1" x2="0" y2="0">
                  <stop offset="0%" stop-color="var(--warm)" />
                  <stop offset="50%" stop-color="var(--accent-2)" />
                  <stop offset="100%" stop-color="var(--accent)" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="container">
      <div class="grid-4">
        {stats.map((stat, i) => (
          <div class={`card stat-card animate-fade-in-up delay-${i+1}`}>
            <h3 class="stat-value" style={`color: ${stat.color}`}>{stat.value}</h3>
            <p class="stat-label">{stat.label}</p>
            {stat.label2 && <p class="stat-sublabel">{stat.label2}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="journey-timeline">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Milestones</span>
        <h2>The Experience Milestones</h2>
        <p class="lede">How HR, high-volume prospecting, and engineering unified into a single skillset.</p>
      </div>

      <div class="timeline-container">
        <div class="timeline-line"></div>
        
        {timeline.map((item, idx) => (
          <div class={`timeline-block ${idx % 2 === 0 ? 'left' : 'right'} animate-fade-in-up`}>
            <div class="timeline-dot" style={`background: ${item.color}; box-shadow: 0 0 0 4px ${item.bgDim}`}></div>
            
            <div class="card timeline-card">
              <div class="timeline-card-header">
                <span class="timeline-phase" style={`color: ${item.color}; background: ${item.bgDim}`}>{item.phase}</span>
                <div class="timeline-icon-wrap" style={`border-color: ${item.color}`}>
                  <svg class="timeline-svg-icon" viewBox="0 0 24 24" fill="none" stroke={item.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={item.iconPath} />
                  </svg>
                </div>
              </div>
              
              <h3>{item.title}</h3>
              <span class="timeline-subtitle">{item.subtitle}</span>
              <p class="timeline-body">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="philosophy-section">
    <div class="container narrow text-center">
      <h2>A sales rep who builds sales tech</h2>
      <p class="text-body text-large">
        I believe that the best sales operations aren't built on rigid instructions, but on <strong class="highlight-text">smart engineering</strong>. Understanding the customer is half the battle; building the software to capture them instantly is the other.
      </p>
      <div class="cta-row justify-center">
        <a href="/case-studies/" class="btn btn-primary">See the case studies</a>
        <a href="/enterprise/" class="btn btn-ghost">Enterprise outreach details</a>
      </div>
    </div>
  </section>

  <style>
    .about-hero {
      padding: 100px 0 60px;
      background: radial-gradient(ellipse 45% 45% at 85% 15%, var(--glow-1), transparent), var(--bg);
    }

    .align-center {
      align-items: center;
    }

    .hero-text {
      max-width: 520px;
    }

    .text-body {
      font-size: 1.08rem;
      color: var(--text);
      line-height: 1.7;
    }

    .text-large {
      font-size: 1.2rem;
      line-height: 1.8;
      margin-bottom: 30px;
    }

    .text-gradient {
      font-weight: 700;
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .text-gradient.warm {
      background-image: linear-gradient(135deg, var(--warm), #f97316);
    }

    .text-gradient.accent {
      background-image: linear-gradient(135deg, var(--accent), var(--accent-2));
    }

    .highlight-text {
      color: var(--accent);
      font-weight: 600;
    }

    /* Visual GPX Route Card */
    .journey-map-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      transition: transform 0.3s ease;
    }

    html.dark .journey-map-card {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .journey-map-card:hover {
      transform: translateY(-4px);
    }

    .card-header {
      background: var(--bg-raise);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 6px;
      border-bottom: 1px solid var(--border);
    }

    .card-header .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .card-header .dot.red { background: #ef4444; }
    .card-header .dot.yellow { background: #eab308; }
    .card-header .dot.green { background: #22c55e; }

    .card-title {
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-dim);
      margin-left: 10px;
    }

    .journey-map {
      padding: 16px;
      display: flex;
      justify-content: center;
      background: var(--bg-card);
    }

    .journey-svg {
      width: 100%;
      height: auto;
      max-height: 240px;
    }

    /* SVG Animations */
    @keyframes drawFlight {
      from {
        stroke-dashoffset: 600;
      }
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes pulse {
      0% {
        transform: scale(0.9);
        opacity: 0.8;
      }
      100% {
        transform: scale(2.2);
        opacity: 0;
      }
    }

    .flight-path {
      stroke-dasharray: 600;
      animation: drawFlight 2.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .pulse-node {
      transform-origin: center;
      animation: pulse 2s infinite ease-out;
    }

    .pulse-node.delay-pulse {
      animation-delay: 1s;
    }

    /* Stats Row */
    .stats-section {
      padding: 40px 0;
      background: var(--bg-raise);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    @media (max-width: 820px) {
      .grid-4 {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 480px) {
      .grid-4 {
        grid-template-columns: 1fr;
      }
    }

    .stat-card {
      text-align: center;
      padding: 24px 16px;
      border-radius: 10px;
    }

    .stat-value {
      font-size: 2.2rem;
      font-weight: 700;
      line-height: 1;
      margin-bottom: 8px;
    }

    .stat-label {
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-dim);
      margin: 0;
    }

    .stat-sublabel {
      font-size: 0.75rem;
      color: var(--text-dim);
      margin: 4px 0 0;
      opacity: 0.85;
    }

    /* Timeline Styling */
    .journey-timeline {
      padding: 80px 0;
    }

    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-header h2 {
      margin-bottom: 12px;
    }

    .section-header .lede {
      margin: 0 auto;
    }

    .timeline-container {
      position: relative;
      max-width: 840px;
      margin: 0 auto;
    }

    .timeline-line {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--border);
      transform: translateX(-50%);
    }

    .timeline-block {
      position: relative;
      width: 50%;
      padding: 0 40px;
      margin-bottom: 40px;
      box-sizing: border-box;
    }

    .timeline-block.left {
      left: 0;
      text-align: right;
    }

    .timeline-block.right {
      left: 50%;
      text-align: left;
    }

    .timeline-dot {
      position: absolute;
      left: 100%;
      top: 24px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      z-index: 2;
    }

    .timeline-block.right .timeline-dot {
      left: 0;
    }

    .timeline-card {
      padding: 24px;
      border-radius: 12px;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .timeline-card:hover {
      transform: translateY(-2px);
    }

    .timeline-card h3 {
      font-size: 1.3rem;
      margin-bottom: 4px;
      color: var(--text);
    }

    .timeline-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      gap: 12px;
    }

    .timeline-block.left .timeline-card-header {
      flex-direction: row-reverse;
    }

    .timeline-phase {
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 4px;
    }

    .timeline-icon-wrap {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1.5px solid;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .timeline-svg-icon {
      width: 16px;
      height: 16px;
    }

    .timeline-subtitle {
      display: block;
      font-size: 0.85rem;
      color: var(--text-dim);
      margin-bottom: 12px;
      font-weight: 500;
    }

    .timeline-body {
      font-size: 0.95rem;
      color: var(--text);
      line-height: 1.6;
      margin: 0;
    }

    /* Philosophy Panel */
    .philosophy-section {
      padding: 80px 0;
      border-top: 1px solid var(--border);
      background: radial-gradient(ellipse 55% 45% at 50% 100%, var(--glow-2), transparent), var(--bg);
    }

    .cta-row {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    .justify-center {
      justify-content: center;
    }

    @media (max-width: 820px) {
      .timeline-line {
        left: 20px;
      }
      .timeline-block {
        width: 100%;
        padding-left: 50px;
        padding-right: 0;
        text-align: left !important;
      }
      .timeline-block.left {
        left: 0;
      }
      .timeline-block.right {
        left: 0;
      }
      .timeline-dot {
        left: 20px !important;
      }
      .timeline-card-header {
        flex-direction: row !important;
      }
      .about-hero {
        padding: 60px 0 40px;
      }
    }
  </style>
</Base>
