---
import Base from '../../layouts/Base.astro';

const studies = [
  {
    href: '/case-studies/cqc-dashboard/',
    tag: 'Shipped · In use company-wide',
    title: 'CQC Research Dashboard',
    body: 'A React/TypeScript app on live CQC data that cut care-provider research from minutes to seconds, adopted company-wide and recognized by the CMO with an "AI Champion" award.',
  },
  {
    href: '/case-studies/lead-enrichment/',
    tag: 'In progress',
    title: 'Lead Enrichment Pipeline',
    body: 'A Python pipeline combining the CQC API and Companies House API to enrich ~180 care companies with decision-maker and structure data for targeted outreach.',
  },
  {
    href: '/case-studies/competitive-intel/',
    tag: 'Living document',
    title: 'Competitive Intelligence Matrix',
    body: 'An accuracy-verified comparison of Nourish against 9+ care-sector competitors, layered with field intelligence from live prospect conversations.',
  },
];
---

<Base
  title="Case Studies | Ishraq Alam"
  description="Sales tools built by an SDR: a CQC research dashboard, a lead enrichment pipeline, and a competitive intelligence matrix."
>
  <section>
    <div class="container">
      <span class="eyebrow animate-fade-in-up">Case studies</span>
      <h1 class="animate-fade-in-up delay-1">Sales problems, solved like an engineer</h1>
      <p class="lede animate-fade-in-up delay-2">
        Each of these started as a bottleneck in my own pipeline. Instead of working
        around it, I built something that removed it for the whole team.
      </p>
      <div class="grid-3 studies animate-fade-in-up delay-3">
        {studies.map((study) => (
          <a href={study.href} class="card study-card">
            <span class="chip">{study.tag}</span>
            <h3>{study.title}</h3>
            <p>{study.body}</p>
            <span class="read-more">Read the case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    section { padding-top: 80px; }

    .studies { margin-top: 40px; }

    .study-card {
      display: flex;
      flex-direction: column;
      color: var(--text);
    }

    .study-card:hover {
      text-decoration: none;
    }

    .study-card .chip {
      align-self: flex-start;
      margin-bottom: 14px;
    }

    .study-card p { color: var(--text-dim); }

    .read-more {
      margin-top: auto;
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--accent);
      transition: transform 0.2s ease;
    }

    .study-card:hover .read-more {
      transform: translateX(4px);
    }
  </style>
</Base>
