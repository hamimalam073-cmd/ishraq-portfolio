---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks | Ishraq Alam" description="Your inquiry has been received.">
  <section>
    <div class="container narrow">
      <span class="eyebrow">Inquiry received</span>
      <h1>Thanks. I'll be in touch shortly.</h1>
      <p class="lede">
        Your message has landed. I typically reply within one working day. In the
        meantime, the case studies are the fastest way to see how I work.
      </p>
      <a href="/case-studies/" class="btn btn-primary">Browse case studies</a>
    </div>
  </section>

  <style>
    section { padding-top: 100px; min-height: 50vh; }
  </style>
</Base>
